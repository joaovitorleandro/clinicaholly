    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.2.5",
    "@fontsource/inter": "^5.2.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.17",
