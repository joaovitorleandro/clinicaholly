{
  "name": "clinica-holly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check:ui-unicode && vue-tsc -b && vite build && node scripts/prerender.mjs",
    "check:ui-unicode": "node scripts/check-ui-unicode.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc -b",
